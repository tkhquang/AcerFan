# EditorConfig for AcerFan (https://editorconfig.org), the same rules as DetourModKit.
# .gitattributes owns the line endings, so this file does not set end_of_line.
root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
trim_trailing_whitespace = true
insert_final_newline = true

# Data and config files use two-space indentation.
[*.{yml,yaml,json}]
indent_size = 2

# C++ sources follow the 120-column limit of .clang-format.
[*.{cpp,hpp}]
max_line_length = 120

# Markdown uses trailing whitespace for hard line breaks.
[*.md]
trim_trailing_whitespace = false
